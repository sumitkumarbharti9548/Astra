# ============================================
# Student Notes Hub — Environment Variables
# ============================================
# NEVER put real secrets in this file.
# This file is only a template.
# Real values go in .env locally and
# Render Environment Variables in production.

# ────────────────────────────────────────────
# Server
# ────────────────────────────────────────────
PORT=5000
NODE_ENV=development


# ────────────────────────────────────────────
# MongoDB Atlas
# ────────────────────────────────────────────
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/student_notes_hub


# ────────────────────────────────────────────
# Authentication
# ────────────────────────────────────────────
JWT_SECRET=your_long_random_jwt_secret_here
JWT_EXPIRE=7d


# ────────────────────────────────────────────
# Frontend URL
# ────────────────────────────────────────────
FRONTEND_URL=http://localhost:5000


# ────────────────────────────────────────────
# Gemini AI
# ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here


# ────────────────────────────────────────────
# Judge0
# ────────────────────────────────────────────
JUDGE0_API_KEY=your_judge0_api_key_here
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com


# ────────────────────────────────────────────
# Email / Resend
# ────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here