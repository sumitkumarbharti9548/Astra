# ============================================
# Student Notes Hub — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (free at mongodb.com/atlas)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/student_notes_hub

# JWT Secret (make this a long random string - you can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_make_it_very_long_and_random_here
JWT_EXPIRE=7d

# Google Gemini AI (free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Judge0 Code Runner (free at rapidapi.com - search Judge0)
JUDGE0_API_KEY=your_judge0_rapidapi_key_here
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com

# Frontend URL (for CORS - change in production)
CLIENT_URL=http://localhost:5000
